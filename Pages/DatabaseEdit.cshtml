@page
@model DatabaseEdit.Pages.DatabaseEditModel
@using System.Data;
@{
}

<div>
        <h1><a href="/">@Model.Config.ServerName</a></h1>
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="message">
            <button>x</button>
            @Html.Raw(Model.Message)
        </div>
    }
    @switch (Model.View)
    {
        case "row":
            {
                <div>
                    <h2>Table @Model.Table row @Model.Row <a href="?view=table&table=@Uri.EscapeDataString(Model.Table)">back</a></h2>

                    <form method="post">
                        <table class="edit">

                            @{
                                var row = Model.Row == -1 ? Model.TableConfig.Data.NewRow() : Model.TableConfig.Data.Rows[Model.Row];
                            }
                            @for (int r = 0; r < Model.TableConfig.Config.Count(); r++)
                            {
                                 var e = Model.TableConfig.Config.ElementAt(r);
                                 var rowType = e[6].ToString();
                                 var value = Model.GetEditValue(e, row[e[3].ToString()]);
                                 <tr>
                                    <td><span title="@(e[6]) (@e[7])">@e[3]</span></td>
                                     @if (Model.TableConfig.IsGenerated(e))
                                     {
                                         <td>@value <em>generated by database</em></td>
                                     }
                                     else if (Model.TableConfig.PrimaryKeys.Contains(e[3].ToString()) && Model.Row >= 0)
                                    {
                                        <td>
                                             <input type="hidden" name="@e[3]" value="@value" />
                                             @value
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            @if (Model.TableConfig.ForeignKeys.ContainsKey(r))
                                            {
                                                var table = Model.TableConfig.ForeignKeys[r];
                                                <select name="@e[3]">
                                                    <option value=""></option>
                                                    @foreach (DataRow val in table.Rows)
                                                    {
                                                        <option value="@(val["key"])" selected="@(val["key"].ToString() == row.ItemArray[r].ToString() )">@(val["value"]) (@val["key"])</option>
                                                    }
                                                </select>

                                            }
                                             else if (rowType == "text" || rowType == "json" || rowType == "jsonb"
                                                 || rowType == "character varying" && e.IsNull(7)
                                                 || rowType.Contains("varchar") && int.TryParse(e[7].ToString(), out int fieldlength) && fieldlength == -1)
                                            {
                                                 <textarea name="@e[3]">@value</textarea>
                                            }
                                             else if (rowType == "bit" && Model.Config.DatabaseType == DatabaseType.MSSQL || rowType == "boolean")
                                            {
                                                 <label> true <input type="radio" name="@e[3]" value="True" checked="@(value == "True")" /></label>
                                                 <label> false <input type="radio" name="@e[3]" value="False" checked="@(value == "False")" /></label>
                                            }
                                             else if (rowType == "uniqueidentifier" || rowType == "uuid")
                                            {
                                                 <input class="guid" type="text" name="@e[3]" value="@value" /> <button type="button" onclick="newguid(event)">new guid</button>
                                            }
                                             else if (Model.IsDateTimeType(rowType))
                                            {
                                                 <input type="text" name="@e[3]" value="@value" />
                                            }
                                             else if (rowType == "int" || rowType == "integer" || rowType == "smallint" || rowType == "bigint")
                                            {
                                                 <input type="number" name="@e[3]" value="@value" />
                                            }
                                            else
                                            {
                                                 <input type="text" name="@e[3]" value="@value" />
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </table>
                        <button type="submit">Save</button>
                        <button type="button" onclick="copyCurrentForm()">copy</button>
                        <button type="button" onclick="pasteCurrentForm()">paste</button>
                    </form>
                    @if (Model.Row >= 0)
                    {
                        <form method="post" asp-page-handler="Delete">
                            <input type="hidden" name="table" value="@Model.Table" />
                            <input type="hidden" name="row" value="@Model.Row" />
                             <button type="submit" onclick="return confirm('are you sure?')">Delete</button>
                        </form>
                    }

                </div>
            }
            break;
        case "config":
            {
                <div>
                    <h2>Table @Model.Table <a href="?">back</a></h2>

                    <table>
                        <tr>
                            @for (int i = 0; i < Model.TableConfig.Config.ElementAt(0).ItemArray.Length; i++)
                            {
                                <td>@i</td>
                            }
                        </tr>
                        @foreach (DataRow row in Model.TableConfig.Config)
                        {
                            <tr>
                                @foreach (var item in row.ItemArray)
                                {
                                    <td>@item</td>
                                }
                            </tr>
                        }
                    </table>
                </div>
            }
            break;
        case "table":
            {
                <div>
                    <h2>Table @Model.Table <a href="?">back</a></h2>

                    <label>search<input id="search" type="text" oninput="searchTable(event)" /></label>
                    <a href="?view=row&table=@Uri.EscapeDataString(Model.Table)&row=-1">new</a>

                    <table id="tablerows">

                        <thead>
                            <tr>
                                @foreach (DataColumn col in Model.TableConfig.Data.Columns)
                                {
                                    <th class="sort">@col.ColumnName</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (int r = 0; r < Model.TableConfig.Data.Rows.Count; r++)
                            {
                                var row = Model.TableConfig.Data.Rows[r];
                                <tr class="clickable" data-href="@(Model.GetQuery("row"))&row=@r" onclick="document.location = this.dataset.href">
                                    @for (int i = 0; i < row.ItemArray.Length; i++)
                                    {
                                        var item = row.ItemArray[i];
                                        var config = Model.TableConfig.Config.ElementAt(i);
                                        if (Model.TableConfig.ForeignKeys.ContainsKey(i) && !string.IsNullOrEmpty(item.ToString()))
                                        {
                                            var table = Model.TableConfig.ForeignKeys.FirstOrDefault(kv => kv.Key == i).Value;
                                            if (table != null && (table.Rows.Cast<DataRow>().FirstOrDefault(r => r["key"].ToString() == item.ToString()) != null)) {
                                                <td>
                                                    @(table.Rows.Cast<DataRow>().First(r => r["key"].ToString() == item.ToString())["value"])
                                                </td>
                                            }
                                            else
                                            {
                                                <td><p title="@item" class="cell-content"><em>[@item]</em></p></td>
                                            }
                                        }
                                         else if (Model.IsDateTimeType(config.ItemArray[6].ToString()) && item != DBNull.Value)
                                        {
                                             <td>@Model.GetEditValue(config, item)</td>
                                        }
                                        else
                                        {
                                            <td><p title="@item" class="cell-content">@Model.GetEditValue(config, item)</p></td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            }
            break;
        case "tables":
            {
                <div>
                    <h2>Tables  <a href="/">change connection</a></h2>
                    <ul>
                        @foreach (var table in Model.Config.GetTables())
                        {
                            <li><a href="?view=table&table=@Uri.EscapeDataString(table)">@table</a>   | <a href="?view=config&table=@Uri.EscapeDataString(table)">config</a>  | <a asp-page-handler="DownloadCSV" asp-route-table="@table" target="_blank">download CSV</a></li>
                        }
                    </ul>
                </div>
            }
            break;
        default:
            {
                <div>Loading...</div>
            }
            break;
    }

</div>
